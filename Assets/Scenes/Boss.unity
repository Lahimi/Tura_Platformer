  entranceWall: {fileID: 633035548}
  bossBGM: {fileID: 8300000, guid: 8db4b348d2252cb449b19bd48ae590c0, type: 3}
  bossName: Stone Man
  bossDialogue:
  - "\"Intruder detected. \nYou have climbed the heights of the \nLabyrinth, \nbut
    your journey ends in this vault.\""
  - "\"The Sol-Aureum belongs to the mountain. \nIt does not leave, and neither will
    you.\""
  - '"Prepare to be buried!"'
  dialoguePanel: {fileID: 898497224}
  nameText: {fileID: 741380128}
  dialogueText: {fileID: 24921771}
  nextButton: {fileID: 102528702}
  victoryBGM: {fileID: 8300000, guid: d5034ad42e6a7064988079b59696c555, type: 3}
  defeatDialogue:
  - "\"The Labyrinth... has chosen its new master.\n You have broken the seal that
    held these\n halls for centuries.\""
  - "\"The Sol-Aureum is yours... but remember:\n gold is a heavy burden to carry
    out of a\n falling temple.\""
  - '"The sanctuary... closes... with me."'
  victoryAnimationTrigger: Victory
  victoryDelay: 7
  creditsSceneName: Credits
